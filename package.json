{
  "name": "backend-api",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "dev:workers": "nodemon src/worker/index.ts",
    "build": "rimraf ./dist && tsc && npm run copy:assets",
    "start": "node dist/index.js",
    "start:workers": "node dist/worker/index.js",
    "migrations:generate": "migrationName=${npm_config_name:-DefaultMigrationName} && npm run build && typeorm migration:generate -d dist/datasource.js src/migrations/$migrationName",
    "migrations:run": "npm run build && typeorm migration:run -d dist/datasource.js",
    "migrations:rollback": "npm run build && npx typeorm migration:revert -d dist/datasource.js",
    "copy:assets": "copyfiles -u 1 \"src/assets/**/*\" dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.1",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "microframework-w3tec": "^0.6.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "multer-s3": "^3.0.1",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "rimraf": "^6.1.3",
    "routing-controllers": "^0.11.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typedi": "^0.10.0",
    "typeorm": "^1.1.0",
    "typescript": "^6.0.3"
  }
}
